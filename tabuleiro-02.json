{
  "boardType": "mixed",
  "version": 1,
  "displayScale": 1.5,
  "viewOffset": {
    "x": 500,
    "y": 0
  },
  "coordinateSystem": {
    "unit": "pixel",
    "tileColumns": 226,
    "tileRows": 226,
