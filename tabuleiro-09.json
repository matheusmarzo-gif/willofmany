        "level9-intro": {
          "title": "Bem-vindo à batalha impossível!",
          "message": "Algumas regiões simplesmente se tornam barreiras inexpugnáveis por construção! Esse é um desses casos. Precisaremos dominar uma mecânica nova nesse mapa: ao ter tropas suficientes em um território você poderá aumentar ou reduzir o rank desse território.",
          "dismissible": true,
          "next": "complete",
          "highlight": ["regions:objectives"]
        },
        "level9-rank-change-tip": {
          "title": "Use o rank a seu favor",
          "message": "Upgrade (aumentar um rank) custa 1 moeda em L8, 4 em L7, 20 em L6, 100 em L5, 350 em L4, 1.000 em L3 e 2.000 em L2. Downgrade (reduzir um rank) custa 1 moeda em L7, 4 em L6, 20 em L5, 100 em L4, 350 em L3, 1.000 em L2 e 2.000 em L1. A operação também exige tropas mínimas e propriedade exclusiva. Use-a para fortalecer territórios próximos ao inimigo e criar bases de avanço.",
          "dismissible": true,
          "next": "level9-rank-change-tip-seen",
          "highlight": ["ui:rankChangeButton"]
        }
      },
      "transitions": [
        {
          "from": "complete",
          "when": {
